{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

{project_plugins, [
    erlfmt,
    rebar3_hank,
    rebar3_ex_doc,
    rebar3_hex
]}.

{erlfmt, [
    write,
    {files, ["{src,include,test}/*.{hrl,erl,app.src}", "rebar.config"]}
]}.

{hank, [
    {ignore, [
        "test/**",
        {"src/ncalendar_format.erl", [unused_callbacks]}
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all]},
        {deps, [
            {nct_util, {git, "https://github.com/nomasystems/nct_util.git", {branch, "main"}}},
            {triq, {git, "https://github.com/nomasystems/triq.git", {branch, "master"}}}
        ]}
    ]}
]}.

{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        unknown,
        extra_return,
        missing_return
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{ct_opts, [
    {verbose, true},
    {ct_hooks, [{cth_surefire, [{path, "report.xml"}]}]}
]}.

{cover_enabled, true}.
{cover_opts, [verbose, {min_coverage, 75}]}.

{alias, [
    {check, [compile, {fmt, "--check"}, xref, dialyzer, hank]},
    {test, [ct, cover]},
    {doc, [{ex_doc, "-f html"}]}
]}.
